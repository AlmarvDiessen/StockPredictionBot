// fastfetch system info screen, opened with Super+i.
//
// Palette (as truecolor SGR, which is what fastfetch's colour fields take):
//   accent #FC6E20 -> 38;2;252;110;32
//   text   #FFE7D0 -> 38;2;255;231;208
//   muted  #8a8a8a -> 38;2;138;138;138
//
// "battery-health" is a small script on PATH (defined in home/default.nix);
// fastfetch's battery module exposes capacity and cycle count but not
// energy_full / energy_full_design, which is what battery health needs.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "nixos",
    "color": {
      "1": "38;2;252;110;32",
      "2": "38;2;255;231;208"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;252;110;32",
      "title": "38;2;255;231;208"
    }
  },

  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;2;252;110;32",
        "host": "38;2;255;231;208"
      }
    },
    "separator",

    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "shell", "key": "Shell" },
    { "type": "wm", "key": "WM" },
    { "type": "terminal", "key": "Term" },
    { "type": "packages", "key": "Pkgs" },

    "break",

    {
      "type": "custom",
      "format": "\u001b[38;2;252;110;32m── Laptop ──────────────────────────\u001b[0m"
    },

    { "type": "host", "key": "Model" },
    { "type": "cpu", "key": "CPU" },
    { "type": "memory", "key": "RAM" },
    { "type": "gpu", "key": "GPU", "format": "{name}" },
    { "type": "gpu", "key": "Driver", "format": "{driver}" },
    { "type": "uptime", "key": "Uptime" },
    {
      "type": "battery",
      "key": "Battery",
      "format": "{capacity} ({status}), {cycle-count} cycles"
    },
    { "type": "command", "key": "Health", "text": "battery-health" },

    "break",
    "colors"
  ]
}
